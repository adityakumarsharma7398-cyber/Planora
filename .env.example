# ==============================================================================
# Planora — AI-Powered Celebration Planner - Production Environment Guide
# ==============================================================================
# IMPORTANT: Never commit '.env' containing real secrets to version control.
# Below is the exact breakdown of variables for Render (Backend) and Vercel (Frontend).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# Client URL (Your deployed Vercel frontend URL, e.g. https://planora.vercel.app)
CLIENT_URL=https://your-planora-app.vercel.app

# Google Gemini AI Configuration (Server-side ONLY - never expose to client!)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL & Auth Configuration (Optional - in-memory fallback enabled)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Security & Rate Limiting Defaults
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Dashboard)
# ------------------------------------------------------------------------------
# Public API URL pointing to your Render backend service
VITE_API_URL=https://your-planora-api.onrender.com

